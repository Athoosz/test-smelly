{
  "env": {
    "node": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2020
  },
  "plugins": ["jest"],
  "extends": ["plugin:jest/recommended"],
  "rules": {
    "jest/no-disabled-tests": "warn",
    "jest/no-conditional-expect": "error",
    "jest/no-identical-title": "error"
  }
}
